{
  "builds": {
    "browser": {
      "define": {
        "__ENVIRONMENT__": "\"production\"",
        "__PLATFORM__": "\"browser\""
      },
      "entryPoints": ["src/index.ts"],
      "mainFields": ["module", "browser", "main"],
      "outdir": "lib/browser",
      "platform": "browser",
      "target": ["chrome111", "firefox114", "edge111", "opera121", "safari16.4"]
    },
    "node": {
      "define": {
        "__ENVIRONMENT__": "\"production\"",
        "__PLATFORM__": "\"node\""
      },
      "entryPoints": ["src/index.ts"],
      "mainFields": ["module", "main"],
      "outdir": "lib/node",
      "platform": "node",
      "target": ["node24.9.0"]
    }
  },
  "declaration": {
    "declarationRollup": true,
    "documentation": true,
    "entryPoints": ["src/index.ts"],
    "tsconfig": "tsconfig-build.json"
  }
}
